generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  role      String   // PATIENT, DRIVER, DISPATCHER, HOSPITAL, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  driverAmbulance Ambulance? @relation("DriverAmbulance")
}

model Ambulance {
  id             String   @id @default(uuid())
  vehicleNumber  String   @unique
  status         String   // AVAILABLE, BUSY, OFFLINE, ON_EMERGENCY
  lat            Float
  lng            Float
  driverId       String?  @unique
  driver         User?    @relation("DriverAmbulance", fields: [driverId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  requests       EmergencyRequest[]
}

model Hospital {
  id               String   @id @default(uuid())
  name             String
  lat              Float
  lng              Float
  emergencyServices String
  status           String   // AVAILABLE, FULL
  contactNumber    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  requests         EmergencyRequest[]
}

model EmergencyRequest {
  id              String   @id @default(uuid())
  patientName     String
  patientAge      Int
  emergencyType   String
  description     String
  condition       String   // Stable, Serious, Critical, Unresponsive
  lat             Float
  lng             Float
  status          String   // REQUESTED, ACCEPTED, GOING_TO_PATIENT, ARRIVED, PATIENT_ONBOARD, GOING_TO_HOSPITAL, ARRIVED_AT_HOSPITAL, COMPLETED
  
  ambulanceId     String?
  ambulance       Ambulance? @relation(fields: [ambulanceId], references: [id])

  hospitalId      String?
  hospital        Hospital? @relation(fields: [hospitalId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
